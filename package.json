{
  "name": "dragon-army",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "optimize": "node optimize/optimize.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "format": "prettier --write \"engine/**/*.ts\" \"page/**/*.js\" \"page/**/*.mjs\" \"utils/**/*.js\" \"scripts/**/*.mjs\" \"web/src/**/*.{js,jsx}\" \"*.{js,json,md}\""
  },
  "devDependencies": {
    "@zeppos/device-types": "^3.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@zeppos/zml": "^0.0.38"
  }
}
